# ---------------------------------------------------------------------------
# ScoreOMR — free, open-source edition
# Copy to .env and edit. The server runs without any third-party API key.
# Primary deployment: pm2 + Node on 3015, api/worker in Docker.
# Every value has a safe default; Google login and HTTPS stay optional.
# ---------------------------------------------------------------------------

APP_ENV=production

# Public origin users open in a browser.  Production should be HTTPS.
# Example: https://omr.example.com:3015
APP_URL=http://localhost:3015

# Daily free recognitions per subject:
#   signed out -> per IP
#   signed in  -> per account
# This is a free, open-source deployment.
DAILY_LIMIT=1

# Google OAuth is OPTIONAL.  Leave blank to use email/password only; the app
# still runs.  If enabled, Google Console's authorised redirect URI must be:
#   {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional; defaults to {APP_URL}/api/auth/google/callback.
GOOGLE_REDIRECT_URI=

# Leave empty to generate a strong secret on first boot and persist it in the
# data volume (/data/session_secret). No NEXTAUTH_SECRET is needed.
SESSION_SECRET=

# Leave empty to derive from APP_URL: https:// => secure cookies.
SESSION_COOKIE_SECURE=

# Time zone used for the daily quota boundary.
APP_TIMEZONE=Asia/Shanghai
SESSION_DAYS=30

# Uploads: images or one-page PDFs. PDFs are rasterised at 200 dpi.
MAX_UPLOAD_MB=20
MAX_GT_MB=2

# Queue / retention. OMR is CPU-heavy: one worker processes one page at a time.
JOB_RETENTION_DAYS=7
JOB_TIMEOUT_SECONDS=900

# Must be false in production; `pnpm dev` sets it to true for a UI-only demo.
OMR_MOCK=false

# Audiveris is memory hungry. 1536m fits a 4 GB server; use 1024m on 2 GB.
AUDIVERIS_HEAP=1536m

# Comma-separated subset of audiveris,homr for the default compare mode.
OMR_ENGINES=audiveris,homr

# One job at a time per account/IP; queue cap.
MAX_ACTIVE_JOBS=1
MAX_QUEUE_LENGTH=20
WORKER_POLL_SECONDS=1.5

# --- pm2 + Node gateway (recommended) --------------------------------------
# The Node gateway serves the SPA and proxies /api to the api container.
PORT=3015
API_HOST_PORT=8000
# Optional TLS directly on 3015. If both are set, Node serves HTTPS.
TLS_CERT_FILE=
TLS_KEY_FILE=
# Set 1 only when the Node gateway is behind Cloudflare/Caddy/host nginx.
EDGE_TRUST_PROXY=0

# --- full-Docker web tier (alternative) ------------------------------------
WEB_PORT=8080

# Optional bundled Caddy TLS proxy:
#   docker compose -f compose.yml -f compose.tls.yml up -d --build
# Set DOMAIN and APP_URL=https://DOMAIN before doing so.
DOMAIN=

# Audiveris is amd64-only. Keep linux/amd64 on Apple Silicon and Aliyun x86_64.
WORKER_PLATFORM=linux/amd64

# Set to 0 to skip baking homr's ONNX/OCR weights into the image.
HOMR_INIT=1

LOG_LEVEL=INFO

# Optional mirrors for builds in mainland China:
#   PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple
#   NPM_REGISTRY=https://registry.npmmirror.com
#   APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://pypi.org/simple
NPM_REGISTRY=https://registry.npmjs.org
APT_MIRROR=

# Audiveris .deb fetch URL (optional GitHub proxy prefix for mainland China).
AUDIVERIS_DEB_URL=https://github.com/Audiveris/audiveris/releases/download/5.11.0/Audiveris-5.11.0-ubuntu24.04-x86_64.deb
